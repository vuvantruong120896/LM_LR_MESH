{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Legacy Env",
			"type": "shell",
			"command": "platformio",
			"args": ["run", "-e", "esp32-c3-devkitm-1"],
			"isBackground": false,
			"group": "build",
			"problemMatcher": ["$platformio"],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			}
		}
	]
}